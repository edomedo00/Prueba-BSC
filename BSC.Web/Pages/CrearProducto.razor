@page "/productos/crear"
@using System.ComponentModel.DataAnnotations
@using System.Net
@using System.Net.Http.Json
@using BSC.Web.Models
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Registrar producto</PageTitle>

<div class="header-pagina">
    <h1>Registrar producto</h1>

    <a href="/" class="btn btn-outline-secondary">
        Volver al inicio
    </a>
</div>

@if (cargando)
{
    <p>Cargando...</p>
}
else if (permitido)
{
    <EditForm Model="@formulario" OnValidSubmit="@GuardarAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="clave" class="form-label">Clave del producto</label>
            <InputText id="clave" class="form-control" @bind-Value="formulario.ClaveProducto" />
        </div>

        <div class="mb-3">
            <label for="nombre" class="form-label">Nombre</label>
            <InputText id="nombre" class="form-control" @bind-Value="formulario.Nombre" />
        </div>

        <div class="mb-3">
            <label for="inventario" class="form-label">
                Existencia inicial
            </label>
            <InputNumber id="inventario" class="form-control" min="0" @bind-Value="formulario.Inventario" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@guardando">
            @(guardando ? "Guardando..." : "Registrar producto")
        </button>
    </EditForm>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger mt-3" role="alert">@error</div>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-success mt-3" role="status">@mensaje</div>
}



@code {
    private ProductoFormulario formulario = new();
    private bool cargando = true;
    private bool permitido;
    private bool guardando;
    private string? error;
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var respuesta = await Http.GetAsync("api/auth/me");

            if (respuesta.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            if (!respuesta.IsSuccessStatusCode)
            {
                error = "No fue posible consultar la sesión.";
                return;
            }

            var usuario = await respuesta.Content.ReadFromJsonAsync<UsuarioSesion>();

            permitido = usuario?.Rol == "Personal administrativo";

            if (!permitido)
            {
                error = "No tienes permiso para registrar productos.";
            }
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con la API.";
        }
        catch (TaskCanceledException)
        {
            error = "La solicitud tardó demasiado.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarAsync()
    {
        if (guardando)
        {
            return;
        }

        guardando = true;
        error = null;
        mensaje = null;

        try
        {
            using var respuesta = await Http.PostAsJsonAsync("api/productos", formulario);

            if (respuesta.IsSuccessStatusCode)
            {
                mensaje = "Producto registrado correctamente.";
                formulario = new();
            }
            else if (respuesta.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login");
            }
            else if (respuesta.StatusCode == HttpStatusCode.Forbidden)
            {
                permitido = false;
                error = "No tienes permiso para registrar productos.";
            }
            else if (respuesta.StatusCode == HttpStatusCode.BadRequest)
            {
                var detalle = await respuesta.Content.ReadFromJsonAsync<ErrorApi>();

                error = detalle?.Mensaje ?? "Verifica los datos del producto.";
            }
            else
            {
                error = "No fue posible registrar el producto.";
            }
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con la API.";
        }
        catch (TaskCanceledException)
        {
            error = "La solicitud tardó demasiado.";
        }
        finally
        {
            guardando = false;
        }
    }

    public class ProductoFormulario
    {
        [Required(ErrorMessage = "La clave es obligatoria.")]
        [StringLength(50, ErrorMessage = "La clave no debe ser mayor a 50 caracteres.")]
        public string ClaveProducto { get; set; } = string.Empty;

        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(100, ErrorMessage = "El nombre no debe ser mayor a 100 caracteres.")]
        public string Nombre { get; set; } = string.Empty;

        [Range(0, int.MaxValue, ErrorMessage = "El inventario no puede ser negativo.")]
        public int Inventario { get; set; }
    }

    public class ErrorApi
    {
        public string? Mensaje { get; set; }
    }
}